{
  "schema_version": 4,
  "fixture": "hallucination",
  "held_out": false,
  "kind": "defect",
  "description": "The merge asserts a capability that appears in neither source, sitting in a paragraph where every other sentence is faithful.",
  "plants": [
    "merged.md line 10 states that upstream traffic can be forwarded through a SOCKS5 proxy; neither source mentions SOCKS5 or upstream proxies at all"
  ],
  "merged": "merged.md",
  "prompts": {
    "source_to_merged": "prompts/verify.md",
    "merged_to_sources": "prompts/verify_reverse.md"
  },
  "claim_count_band": {
    "source_a.md": [
      4,
      9
    ],
    "source_b.md": [
      4,
      9
    ],
    "merged.md": [
      7,
      13
    ]
  },
  "probes": [
    {
      "probe_id": "merged-socks5",
      "direction": "merged_to_sources",
      "document": "merged.md",
      "line": 10,
      "text": "Upstream traffic can be forwarded through a SOCKS5 proxy.",
      "must_extract": true,
      "anchor": {
        "all_of": [
          "SOCKS5"
        ]
      },
      "match": {
        "all_of": [
          "SOCKS5"
        ]
      },
      "expected_verdict": "MISSING",
      "also_acceptable": [],
      "expected_finding": "hallucinated",
      "note": "The planted defect, and the reason the reverse direction exists. Under merged_to_sources, MISSING means the merge invented a fact — a different failure class from a dropped claim, despite carrying the same verdict label. The forward pass cannot see this at all: no source claim goes unsupported, so coverage alone reports a clean run."
    },
    {
      "probe_id": "merged-connect-timeout",
      "direction": "merged_to_sources",
      "document": "merged.md",
      "line": 8,
      "text": "The default connect timeout is 30 seconds.",
      "must_extract": true,
      "anchor": {
        "all_of": [
          "connect timeout",
          "30 seconds"
        ]
      },
      "match": {
        "all_of": [
          "connect timeout",
          "30 seconds"
        ]
      },
      "expected_verdict": "SUPPORTED",
      "also_acceptable": [],
      "expected_finding": "none",
      "expected_evidence_contains": [
        "30 seconds"
      ],
      "note": "Two lines above the invented claim. Guards against a reverse pass that condemns the paragraph once one sentence in it is unsupported."
    },
    {
      "probe_id": "merged-max-connections",
      "direction": "merged_to_sources",
      "document": "merged.md",
      "line": 9,
      "text": "The relay accepts at most 512 concurrent connections.",
      "must_extract": true,
      "anchor": {
        "all_of": [
          "512 concurrent connections"
        ]
      },
      "match": {
        "all_of": [
          "512 concurrent connections"
        ]
      },
      "expected_verdict": "SUPPORTED",
      "also_acceptable": [],
      "expected_finding": "none",
      "note": "Directly above the invented claim, and drawn from source_b while its neighbours come from source_a. Guards against a reverse pass that flags anything it cannot find in whichever source it looked at first."
    },
    {
      "probe_id": "a-listen-port",
      "direction": "source_to_merged",
      "document": "source_a.md",
      "line": 7,
      "text": "The relay listens on port 8443 by default.",
