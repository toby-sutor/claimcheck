    {
      "probe_id": "a-client-cert",
      "direction": "source_to_merged",
      "document": "source_a.md",
      "line": 13,
      "text": "Client certificate verification is disabled by default.",
      "must_extract": true,
      "anchor": {
        "all_of": [
          "client certificate verification",
          "disabled by default"
